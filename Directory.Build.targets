<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'TextCraft'">
    <ProductName>НеZнайка</ProductName>
    <FriendlyName>НеZнайка</FriendlyName>
    <PublisherName>НеZнайка</PublisherName>
    <ApplicationVersion>1.0.18.0</ApplicationVersion>
    <OfficeApplicationDescription>НеZнайка — локальная AI-надстройка для Microsoft Word</OfficeApplicationDescription>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'TextCraft'">
    <EmbeddedResource Include="$(MSBuildProjectDirectory)\Assets\NeZnaikaOwl.jpg">
      <LogicalName>TextForge.NeZnaikaOwl.jpg</LogicalName>
      <Type>Non-Resx</Type>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <Compile Include="$(MSBuildProjectDirectory)\Forge.ModelControl.cs" />
    <Compile Include="$(MSBuildProjectDirectory)\Forge.LogicalLink.cs" />
    <Compile Include="$(MSBuildProjectDirectory)\GenerateUserControl.AuditFix.cs" />
    <Compile Include="$(MSBuildProjectDirectory)\GenerateUserControl.AuditPanel.cs" />
  </ItemGroup>

  <Target Name="ApplyNeZnaikaBranding"
          BeforeTargets="CoreResGen"
          Condition="'$(MSBuildProjectName)' == 'TextCraft'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\ci\apply-neznaika-branding-safe.ps1&quot;" />
  </Target>

  <Target Name="ApplyTextCraftRagAndDefaultModelPatch"
          BeforeTargets="BeforeCompile"
          Condition="'$(MSBuildProjectName)' == 'TextCraft'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\ci\apply-rag-chat-and-default-model.ps1&quot;" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -Command &quot;$p='$(MSBuildProjectDirectory)\ci\apply-long-response-control.ps1'; $s=[System.IO.File]::ReadAllText($p,[System.Text.Encoding]::UTF8); Invoke-Expression $s&quot;" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\ci\apply-continue-response.ps1&quot;" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\ci\apply-model-controls.ps1&quot;" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\ci\apply-logical-link.ps1&quot;" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\ci\apply-audit-fix.ps1&quot;" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\ci\repair-audit-stage2-hotfix-script.ps1&quot;" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\ci\apply-audit-stage2-hotfix.ps1&quot;" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\ci\apply-audit-crash-safe.ps1&quot;" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\ci\apply-audit-apply-stability.ps1&quot;" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\ci\repair-audit-apply-catches.ps1&quot;" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\ci\apply-audit-postapply-handle-guard.ps1&quot;" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\ci\apply-audit-headless-review.ps1&quot;" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\ci\keep-neznaika-1.0.18.ps1&quot;" />
  </Target>
</Project>